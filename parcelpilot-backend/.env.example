# Only one key needed — embeddings run locally (sentence-transformers), no
# separate embedding API required.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
MODEL_NAME=openai/gpt-oss-20b


EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where the real data pack lives. Drop the 6 PDFs into data/pdfs/ and the
# workbook at data/ParcelPilot_Assessment_Data.xlsx before running ingest.
PDF_DIR=./data/pdfs
WORKBOOK_PATH=./data/ParcelPilot_Assessment_Data.xlsx

CHROMA_PERSIST_DIR=./data/db/chroma
SQLITE_DB_PATH=./data/db/parcelpilot.db
CHECKPOINT_DB_PATH=./data/db/checkpoints.sqlite

